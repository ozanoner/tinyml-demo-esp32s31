  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime — who owns what",
      "items": [
        "feed task, core 0, prio 5 — blocks on Audio::read(), feeds the AFE",
        "detect task, core 1, prio 5 — creates MultiNet, runs WakeNet + MultiNet",
        "inference task, prio 5, 8 KB PSRAM stack — created by the first capture",
        "capture_wq, prio 2, 8 KB — camera capture off the LVGL task",
        "LVGL port task — splash, screen, countdown timer, splash timer"
      ]
    },
    {
      "dot": "emerald",
      "title": "One app, two boards",
      "items": [
        "CMakePresets.json sets DEVKIT + its own build dir and sdkconfig",
        "main/ REQUIRES devkit_api and only the selected devkit component",
        "EXCLUDE_COMPONENTS drops the other devkit: both BSPs export the same symbols",
        "models load from the 6 MB 'model' SPIFFS partition, not the app image"
      ]
    },
    {
      "dot": "amber",
      "title": "Voice → photo",
      "items": [
        "WakeNet9 spots \"Hi, ESP\", MultiNet7 then listens for a command",
        "33 commands are registered; only \"cheese\" triggers a capture",
        "a 3 s countdown, then capture, conversion and one YOLO11n 320x320 pass"
      ]
    }
  ]
