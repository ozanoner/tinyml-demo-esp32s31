  "cards": [
    {
      "dot": "cyan",
      "title": "Two audio tasks, one AFE",
      "items": [
        "The feed task only reads the microphone and pushes chunks into the AFE",
        "The detect task pulls results out and owns both models' state",
        "They are pinned to core 0 and core 1 and share the AFE handle"
      ]
    },
    {
      "dot": "emerald",
      "title": "Nothing heavy on the LVGL task",
      "items": [
        "The countdown is an LVGL timer; when it ends it notifies the capture worker",
        "Capture, conversion and inference all run off the LVGL task",
        "Cross-task label writes are marshalled with lv_async_call()"
      ]
    },
    {
      "dot": "amber",
      "title": "One frame in flight",
      "items": [
        "Detector refuses a second frame while one is being inferred",
        "The frame is copied once, into the Detector's own RGB888 buffer",
        "The result callback carries what the model reported, nothing translated"
      ]
    }
  ]
