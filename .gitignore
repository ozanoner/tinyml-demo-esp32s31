.pytest_cache/
__pycache__/

# esp-idf built binaries
build/
build_*_*/
sdkconfig

# idf-ci build run output
build_summary_*.xml
app_info_*.txt
size_info_*.txt

# pytest-embedded log folder
pytest_embedded_log/

# idf-component-manager output
dependencies.lock
managed_components/

# archify run artefacts — the generated diagrams and their JSON sources are
# committed, the run receipts are not
docs/architecture/*.finalize.json
docs/architecture/*.finalize-summary.json
docs/architecture/*.browser-check.json
docs/architecture/*.delivery.json
docs/architecture/review-*/
