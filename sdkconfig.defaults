# Shared, devkit-independent settings.
#
# Devkit-specific settings live in devkits/<devkit>/sdkconfig.defaults and are
# applied after this file (the later file wins) — see the top-level
# CMakeLists.txt. Selecting a devkit is what brings in flash size, PSRAM,
# the camera sensor and the partition table.

# LVGL — Montserrat type scale used by the UI (main/ui_theme.hpp).
# 28 — status line (the state, and the countdown)
# 20 — directive line ("say ...", "tap to clear")
# 14 — detection list rows, LVGL's own default
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_20=y

# ESP-SR configuration
# WakeNet9 "Hi,ESP"
CONFIG_SR_WN_WN9_HIESP=y
# MultiNet7 English (command detection)
CONFIG_SR_MN_EN_MULTINET7_QUANT=y
# Use WebRTC NS (no dedicated NS model needed)
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y

# COCO detect model — 320x320 (smaller/faster than 640x640)
CONFIG_FLASH_COCO_DETECT_YOLO11N_S8_V1=
CONFIG_FLASH_COCO_DETECT_YOLO11N_320_S8_V1=y
CONFIG_COCO_DETECT_YOLO11N_320_S8_V1=y

# Load the YOLO11n model from its own flash partition instead of linking it
# into the app image (issue #69). The label "coco_det" is fixed by the
# component (coco_detect.cpp:8-9), and the build flashes the packed .espdl
# there via esptool_py_flash_to_partition. This is a Kconfig choice, so the
# RODATA default has to be turned off explicitly.
CONFIG_COCO_DETECT_MODEL_IN_FLASH_PARTITION=y
# CONFIG_COCO_DETECT_MODEL_IN_FLASH_RODATA is not set
