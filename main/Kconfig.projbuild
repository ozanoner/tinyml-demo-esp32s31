menu "Devkit selection"

    # Exactly one devkit is compiled in. The selection must agree with the DEVKIT
    # variable the devkit preset sets, which picks the devkit defaults layered
    # onto this build's sdkconfig and the devkit component that is compiled.
    choice DEVKIT_SELECT
        prompt "Target devkit"
        default DEVKIT_KORVO1
        help
            The devkit this firmware targets. Selects the devkit component under
            devkits/<name>/ and, with it, the BSP for that board.

            Build with: idf.py --preset <name> build

        config DEVKIT_KORVO1
            bool "ESP32-S31 Korvo-1"

        config DEVKIT_MOSAICO
            bool "ESP-Mosaico"

    endchoice

endmenu
